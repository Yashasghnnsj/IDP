# AcuSound Environment Variables – TEMPLATE
# Copy this file to .env and fill in your real values.
# .env is git-ignored and will never be committed.

# ── Frontend (Vite) ──────────────────────────────────────────────
# Your OpenRouter API key (get one at https://openrouter.ai/keys)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# URL of your deployed FastAPI backend (no trailing slash)
# In development this is unused – Vite proxies /api/* to localhost:8000
VITE_API_BASE_URL=https://idp-acusound.onrender.com

# ── Backend (FastAPI / Python) ────────────────────────────────────
# Same OpenRouter key used server-side when proxying LLM calls
OPENROUTER_API_KEY=your_openrouter_api_key_here
